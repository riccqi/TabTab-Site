{
  "name": "@riccqi/tabtab",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "validate:routes": "node scripts/validate-routes.mjs",
    "verify": "npm run test:email && npm run check && npm run build && npm run validate:routes",
    "test:email": "node --test backend/test/*.test.mjs",
    "email:dev": "wrangler dev --config backend/wrangler.jsonc",
    "email:deploy": "wrangler deploy --config backend/wrangler.jsonc",
    "email:migrate": "wrangler d1 migrations apply tabtab-email --config backend/wrangler.jsonc --remote",
    "preview": "astro preview",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.3.8",
    "marked": "^18.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.150.0"
  },
  "dependencies": {
    "@riccqi/email-studio": "https://raw.githubusercontent.com/riccqi/opencam-site/4e02fb3dbf151691613497f6a81c34da8ae1e693/packages/releases/riccqi-email-studio-1.4.0.tgz"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
