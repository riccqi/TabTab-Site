---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | null;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const defaultTitle = "TabTab: Search & Switch Windows and Tabs on Mac";
const defaultDescription = "Tired of losing track of windows and browser tabs? TabTab is a powerful Mac window switcher that lets you instantly search and switch to anything. Compact, fast, and beautiful.";
const {
  title = defaultTitle,
  description = defaultDescription,
  socialImage = "/og-image.png",
  ogType = "website",
  structuredData,
} = Astro.props;
const siteUrl = Astro.site ?? new URL("https://tabtabapp.net");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = socialImage ? new URL(socialImage, siteUrl) : null;
const softwareApplicationData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TabTab",
  url: new URL("/", siteUrl).href,
  image: new URL("/og-image.png", siteUrl).href,
  operatingSystem: "macOS 14.0 or later",
  applicationCategory: "UtilitiesApplication",
  softwareVersion: "2.1",
  downloadUrl: "https://github.com/riccqi/TabTabApp/releases/download/prod/tabtab-latest.dmg",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: new URL("/pricing/", siteUrl).href,
  },
  featureList: [
    "Switch between Mac windows",
    "Search browser and app tabs by title or URL",
    "Search by app name and window title",
    "Customizable keyboard shortcuts",
  ],
  description: defaultDescription,
};
const resolvedStructuredData = structuredData ?? (Astro.url.pathname === "/" ? softwareApplicationData : undefined);
---
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P4PBQ5VZC9"></script>
<script>
  // @ts-ignore
  window.dataLayer = window.dataLayer || [];
  // @ts-ignore
  function gtag(){dataLayer.push(arguments);}
  // @ts-ignore
  gtag('js', new Date());

  // @ts-ignore
  gtag('config', 'G-P4PBQ5VZC9');
</script>

<title>{title}</title>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="author" content="Richard Qi" />

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl.href} />}

<!-- Twitter -->
<meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={canonicalUrl.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl.href} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl.href} />

<!-- Favicon -->
<link rel="shortcut icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="msapplication-TileColor" content="#ffffff">
<meta name="theme-color" content="#ffffff">
<!--Ionicons -->
<script
  is:inline
  type="module"
  src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
></script>
<!--
https://rsms.me/inter/
-->
<link rel="preconnect" href="https://rsms.me/" />
<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

<!---- Alpine  -->
<script is:inline defer src="https://unpkg.com/@alpinejs/collapse@3.10.5/dist/cdn.min.js"></script>
<script is:inline defer src="https://unpkg.com/alpinejs@3.10.5/dist/cdn.min.js"></script>

{resolvedStructuredData && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(resolvedStructuredData)} />
)}
