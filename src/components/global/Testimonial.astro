---
import { reviews, sourceIcons } from "../../data/reviews";

// Both rows hold every review (the second one rotated) so they have identical
// widths and loop in lockstep. Each row is rendered three times: the scroller
// starts on the middle copy and jumps by one copy at the edges, so it can be
// scrubbed forever in either direction.
const half = Math.ceil(reviews.length / 2);
const rows = [reviews, [...reviews.slice(half), ...reviews.slice(0, half)]];
const copies = [0, 1, 2];
---

<section>
  <div class="mx-auto w-full lg:px-24 max-w-7xl md:px-12 items-center px-8 py-12">
    <!-- Section icon -->
    <div class="flex justify-center mb-6">
      <div class="bg-gradient-to-br from-green-300 to-green-500 rounded-2xl md:rounded-3xl p-5">
        <img src="/symbols/scroll.fill.svg" alt="Scroll icon" class="w-8 h-8 md:w-12 md:h-12 filter brightness-0 invert">
      </div>
    </div>

    <div>
      <p class="text-center text-4xl tracking-tight font-medium text-black md:text-5xl font-display">
        Trusted by users
      </p>
      <p class="text-center text-lg text-gray-500 mt-4 max-w-2xl mx-auto">
        TabTab is the go-to window and tab switcher for Mac users.<br> See what some of them are saying.
      </p>
    </div>
  </div>

  <div data-review-carousel>
    <div
      class="review-scroller overflow-x-auto pb-4"
      aria-label="User reviews"
      role="region"
      tabindex="0"
      data-review-scroller
    >
      <div class="flex w-max flex-col gap-4 md:gap-6">
        {rows.map((row, rowIndex) => (
          <div class:list={["flex gap-4 md:gap-6", rowIndex === 1 && "pl-[calc(var(--review-card-w)/2)]"]}>
            {copies.map((copy) =>
              row.map((review) => (
                <figure
                  class="review-card relative flex flex-col justify-between rounded-panel border border-gray-200 bg-gray-50 p-6"
                  aria-hidden={copy !== 1 ? "true" : undefined}
                >
                  <blockquote class="text-sm md:text-base text-gray-600 font-normal">
                    "{review.quote}"
                  </blockquote>
                  <figcaption class="mt-6 flex items-center justify-between gap-4">
                    <div class="flex min-w-0 items-center gap-3">
                      {review.avatar ? (
                        <img
                          src={review.avatar}
                          alt=""
                          width="36"
                          height="36"
                          class="h-9 w-9 shrink-0 rounded-full bg-gray-200 object-cover"
                        >
                      ) : (
                        <span
                          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gray-200 text-sm font-semibold text-gray-500"
                          aria-hidden="true"
                        >
                          {review.name.charAt(0)}
                        </span>
                      )}
                      <p class="truncate text-sm md:text-base text-gray-500 font-display font-semibold">
                        {review.href ? (
                          <a
                            href={review.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            tabindex={copy !== 1 ? -1 : undefined}
                              class="hover:text-accent-500 inline-flex items-center gap-1"
                          >
                            {review.name}
                          </a>
                        ) : (
                          review.name
                        )}
                      </p>
                    </div>
                    {review.source && (
                      <img
                        src={sourceIcons[review.source].src}
                        alt={sourceIcons[review.source].label}
                        title={sourceIcons[review.source].label}
                        class="w-5 h-5 opacity-50"
                      >
                    )}
                  </figcaption>
                </figure>
              ))
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  [data-review-carousel] {
    --review-card-w: 300px;
  }

  @media (min-width: 768px) {
    [data-review-carousel] {
      --review-card-w: 360px;
    }
  }

  .review-card {
    width: var(--review-card-w);
    flex-shrink: 0;
  }

  .review-scroller {
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .review-scroller::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const SPEED = 40; // px per second
  const RESUME_DELAY = 2000; // ms after the user stops interacting

  document.querySelectorAll<HTMLElement>("[data-review-carousel]").forEach((root) => {
    const scroller = root.querySelector<HTMLElement>("[data-review-scroller]");
    const firstRow = scroller?.firstElementChild?.firstElementChild as HTMLElement | null;
    if (!scroller || !firstRow) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const cards = () => Array.from(firstRow.children) as HTMLElement[];

    // Width of one copy of a row: the distance between the first card of copy 1 and copy 2.
    let loopWidth = 0;
    const measure = () => {
      const all = cards();
      const perCopy = all.length / 3;
      loopWidth = all[perCopy].offsetLeft - all[0].offsetLeft;
    };

    let position = 0; // float accumulator; scrollLeft rounds on some browsers
    const setPosition = (value: number) => {
      if (value < loopWidth * 0.5) value += loopWidth;
      else if (value > loopWidth * 1.5) value -= loopWidth;
      position = value;
      scroller.scrollLeft = value;
    };

    let touching = false;
    let pausedUntil = 0;
    const pause = () => {
      pausedUntil = performance.now() + RESUME_DELAY;
    };

    // Native scrolling (trackpad, touch, keyboard) counts as interaction.
    scroller.addEventListener("scroll", () => {
      if (Math.abs(scroller.scrollLeft - position) > 1) {
        pause();
        setPosition(scroller.scrollLeft);
      }
    }, { passive: true });

    scroller.addEventListener("focusin", pause);

    // Hold still while a finger is on the carousel, so swipes aren't fought.
    scroller.addEventListener("touchstart", () => (touching = true), { passive: true });
    const release = () => {
      touching = false;
      pause();
    };
    scroller.addEventListener("touchend", release);
    scroller.addEventListener("touchcancel", release);

    window.addEventListener("resize", () => {
      const offset = position - loopWidth;
      measure();
      setPosition(loopWidth + offset);
    });

    measure();
    setPosition(loopWidth);

    if (reducedMotion) return;

    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(now - last, 100);
      last = now;
      if (!touching && now > pausedUntil) {
        setPosition(position + (SPEED * dt) / 1000);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
