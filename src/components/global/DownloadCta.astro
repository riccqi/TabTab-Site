---
interface Props {
  title?: string;
  description?: string;
  /** Wrap in the page section padding; off when the banner sits inside a page's own layout. */
  standalone?: boolean;
}

const {
  title = "Try TabTab free",
  description = "Runs on Intel and Apple Silicon Macs running macOS 14 or later.",
  standalone = true,
} = Astro.props;
---

<section class:list={[standalone ? "px-8 py-16 md:px-12" : "mt-16"]}>
  <div class="mx-auto max-w-4xl rounded-panel bg-gray-950 p-8 text-left text-white md:p-10">
    <div class="inline-flex bg-gradient-to-br from-accent-300 to-accent-500 rounded-2xl p-3.5">
      <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M5 21h14" />
      </svg>
    </div>
    <h2 class="mt-5 text-3xl font-medium tracking-tight font-display md:text-4xl">{title}</h2>
    <p class="mt-3 max-w-md text-lg leading-7 text-gray-300">{description}</p>
    <a
      class="mt-7 inline-flex items-center justify-center h-12 px-6 font-bold md:text-base rounded-button bg-white border-2 border-white text-black duration-200 hover:bg-transparent hover:text-white focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white whitespace-nowrap"
      href="/download/"
    >
      Try for Free
    </a>
  </div>
</section>
