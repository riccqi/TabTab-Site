---
import { subscriptionPlan, downloadUrl } from "../../data/billing.mjs";

interface Props {
  title?: string;
  description?: string;
  /** Wrap in the page section padding; off when the banner sits inside a page's own layout. */
  standalone?: boolean;
}

const {
  title = `Try TabTab free for ${subscriptionPlan.trialDays} days`,
  description = "Download TabTab for Intel and Apple Silicon Macs running macOS 14 or later.",
  standalone = true,
} = Astro.props;
---

<section class:list={[standalone ? "px-8 py-16 md:px-12" : "mt-16"]}>
  <div class="mx-auto max-w-4xl rounded-panel bg-gray-950 p-8 text-left text-white md:p-10">
    <div class="inline-flex bg-gradient-to-br from-accent-300 to-accent-500 rounded-2xl p-3.5">
      <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M5 21h14" />
      </svg>
    </div>
    <h2 class="mt-5 text-3xl font-medium tracking-tight font-display md:text-4xl">{title}</h2>
    <p class="mt-3 max-w-md text-lg leading-7 text-gray-300">{description}</p>
    <a
      class="mt-7 inline-flex items-center justify-center h-12 px-6 font-bold md:text-base rounded-button bg-white border-2 border-white text-black duration-200 hover:bg-transparent hover:text-white focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white whitespace-nowrap"
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5 md:w-6 md:h-6 mr-2" fill="currentColor" aria-hidden="true">
        <path d="M19.37 7.648c-.114.088-2.11 1.213-2.11 3.715 0 2.894 2.54 3.918 2.616 3.944-.011.062-.403 1.402-1.34 2.767-.834 1.201-1.706 2.4-3.032 2.4s-1.667-.77-3.198-.77c-1.492 0-2.022.796-3.235.796-1.214 0-2.06-1.112-3.033-2.477C4.911 16.42 4 13.93 4 11.566c0-3.791 2.465-5.802 4.891-5.802 1.29 0 2.364.847 3.173.847.77 0 1.972-.897 3.438-.897.556 0 2.553.05 3.867 1.934Zm-4.564-3.54c.607-.719 1.036-1.718 1.036-2.716 0-.138-.012-.279-.037-.392-.987.037-2.161.657-2.87 1.478-.555.632-1.074 1.63-1.074 2.643 0 .152.026.304.037.353.063.011.164.025.266.025.885 0 1.998-.593 2.642-1.39Z" />
      </svg>
      Download
    </a>
  </div>
</section>
