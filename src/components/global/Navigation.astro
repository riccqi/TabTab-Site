---
import { Image } from "astro:assets";
import tabtabImage from "../../../public/tabtab-full.png";
---
<section class="bg-black/[0.03] backdrop-blur-md rounded-2xl md:rounded-panel shadow-lg mx-4 md:mx-4 lg:mx-8 sticky top-1.5 md:top-4 z-50">
  <div class="px-0 lg:px-20">
    <div
      x-data="{ open: false }"
      class="relative w-full py-1.5 mx-auto md:px-6 flex flex-col md:grid md:grid-cols-3 md:items-center">
      <div class="flex flex-row items-center justify-between lg:justify-start">
        <div class="relative w-24 h-10 md:w-36 md:h-16">
          <Image src={tabtabImage} width={144} densities={[1, 2]} format="webp" quality={85} loading="eager" alt="TabTab" class="w-full h-full object-contain" />
          <a href="/" class="absolute inset-0">
            <span class="sr-only">Home</span>
          </a>
        </div>
        <button
          @click="open = !open"
          aria-label="Toggle navigation"
          :aria-expanded="open"
          class="inline-flex items-center justify-center p-2 text-gray-400 hover:text-black focus:outline-none focus:text-black md:hidden">
          <svg
            class="w-6 h-6"
            stroke="currentColor"
            fill="none"
            viewBox="0 0 24 24">
            <path
              :class="{'hidden': open, 'inline-flex': !open }"
              class="inline-flex"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              :class="{'hidden': !open, 'inline-flex': open }"
              class="hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <nav
        :class="{'flex': open, 'hidden': !open}"
        class="flex-col items-center hidden md:pb-0 md:flex md:flex-row md:justify-center md:col-start-2 md:col-end-3">
        <!-- Center section -->
        <div class="flex flex-col items-center md:flex-row md:items-center space-y-2 md:space-y-0">
          <a
            class="px-2 lg:px-6 py-2 md:px-3 text-sm font-bold text-black hover:text-accent-400 whitespace-nowrap"
            href="/#features">Features</a
          >
          <a
            class="px-2 lg:px-6 py-2 md:px-3 text-sm font-bold text-black hover:text-accent-400 whitespace-nowrap"
            href="/pricing/">Pricing</a
          >
          <a
            class="px-2 lg:px-6 py-2 md:px-3 text-sm font-bold text-black hover:text-accent-400 whitespace-nowrap"
            href="/#faq">
            FAQ
          </a>
          <a
            class="px-2 lg:px-6 py-2 md:px-3 text-sm font-bold text-black hover:text-accent-400 whitespace-nowrap"
            href="/press/">
            Press Kit
          </a>
          <a
            class="md:hidden px-4 py-2 mb-2 text-sm font-bold text-white bg-black rounded-button whitespace-nowrap"
            href="/download/">
            Try for Free
          </a>
        </div>
      </nav>
      <!-- Primary action (right aligned on desktop; in the menu on mobile) -->
      <div class="hidden md:flex items-center md:justify-self-end md:col-start-3">
        <a
          class="items-center justify-center h-12 font-bold text-xs sm:text-sm md:text-base rounded-button focus-visible:outline-black focus:outline-none inline-flex bg-black border-2 border-black duration-200 focus-visible:ring-black hover:bg-transparent hover:border-black hover:text-black px-4 md:px-6 md:py-4 text-center text-white whitespace-nowrap"
          href="/download/"
        >
          Try for Free
        </a>
      </div>
    </div>
  </div>
</section>
