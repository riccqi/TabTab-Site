---
import { supportedAppGroups } from "../../data/supportedApps";
import { subscriptionPlan, planPrice } from "../../data/billing.mjs";
import FaqItem from "./FaqItem.astro";

const { trialDays } = subscriptionPlan;
---
<section aria-labelledby="faq-section" id="faq">  
  <div
    class="mx-auto w-full lg:px-24 max-w-7xl md:px-12 items-center px-8 py-24 scroll-mt-20"
  >
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
      <div class="text-center lg:text-left">
        <div>
          <h2
            id="faq-section"
            class="text-3xl font-medium tracking-tight sm:text-4xl"
          >
            Frequently asked questions
          </h2>
          <p class="text-base mt-4 text-zinc-500">
            Answers to commonly asked questions about TabTab
          </p>
        </div>
      </div>
      <div
        x-data="{
  activeAccordion: '',
  setActiveAccordion(id) {
  this.activeAccordion = (this.activeAccordion == id) ? '' : id
  }
  }"
        class="relative w-full mx-auto font-normal lg:col-span-2"
      >
        <div
          x-data="{ id: $id('accordion') }"
          :class="{ 'text-black': activeAccordion==id, 'text-zinc-600 hover:text-accent-500': activeAccordion!=id }"
          class="cursor-pointer group text-black"
        >
          <button
            @click="setActiveAccordion(id)"
            class="flex items-center justify-between w-full p-4 pb-1 text-left font-medium select-none"
          >
            <span>How does TabTab work?</span>
            <svg
              style="min-width: 20px; min-height: 20px; width: 20px; height: 20px;"
              class="duration-300 ease-out text-accent-500 flex-shrink-0 !shrink-0"
              :class="{ '-rotate-[45deg]': activeAccordion==id }"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v12m6-6H6"></path></svg
            >
          </button>
          <div x-show="activeAccordion==id" x-collapse="">
            <div class="p-4 pt-2 text-zinc-500">
              TabTab uses Apple's Accessibility framework to control your Mac
              and track the windows and tabs you're using. 
              <br>
              It is a fully native macOS app built with AppKit and SwiftUI.
            </div>
          </div>
        </div>
        <FaqItem question="How much does TabTab cost?">
          TabTab is {planPrice} after a {trialDays}-day free trial. The subscription renews automatically every {subscriptionPlan.interval} until you cancel.
        </FaqItem>
        <FaqItem question="Can I cancel anytime?">
          Yes. Cancel before the trial ends and you won't be charged. After that, TabTab stays active until the end of the period you've paid for.
        </FaqItem>
        <FaqItem question="What about refunds?">
          For billing questions, including refunds, email <strong><em><span class="protected-email">hello@tabtabapp.net</span></em></strong>. If a subscription payment is fully refunded, the subscription is cancelled and access ends.
        </FaqItem>
        <div
          x-data="{ id: $id('accordion') }"
          :class="{ 'text-black': activeAccordion==id, 'text-zinc-600 hover:text-accent-500': activeAccordion!=id }"
          class="cursor-pointer group text-zinc-600 hover:text-accent-500"
        >
          <button
            @click="setActiveAccordion(id)"
            class="flex items-center justify-between w-full p-4 pb-1 text-left font-medium select-none"
          >
            <span
              >How is my data handled?</span
            >
            <svg
              style="min-width: 20px; min-height: 20px; width: 20px; height: 20px;"
              class="duration-300 ease-out text-accent-500 flex-shrink-0 !shrink-0"
              :class="{ '-rotate-[45deg]': activeAccordion==id }"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v12m6-6H6"></path></svg
            >
          </button>
          <div
            x-show="activeAccordion==id"
            x-collapse=""
            style="display: none;"
          >
            <div class="p-4 pt-2 text-zinc-500">
              Privacy is essential for an app that is part of your daily workflow. TabTab does not collect personally identifiable information. Window and tab data is processed locally on your Mac, while anonymous usage analytics from TelemetryDeck help monitor app performance and guide updates. See the <a href="/privacy/" class="font-semibold text-accent-500 hover:text-black">Privacy Policy</a> for details.
            </div>
          </div>
        </div>
        <FaqItem question="How many Macs can I use?">
          Each subscription covers up to {subscriptionPlan.devices} Macs. Lifetime licenses keep the number of devices they were sold with.
        </FaqItem>
        <div
          x-data="{ id: $id('accordion') }"
          :class="{ 'text-black': activeAccordion==id, 'text-zinc-600 hover:text-accent-500': activeAccordion!=id }"
          class="cursor-pointer group text-zinc-600 hover:text-accent-500"
        >
          <button
            @click="setActiveAccordion(id)"
            class="flex items-center justify-between w-full p-4 pb-1 text-left font-medium select-none"
          >
            <span>Which apps support the tab management feature?</span>
            <svg
              style="min-width: 20px; min-height: 20px; width: 20px; height: 20px;"
              class="duration-300 ease-out text-accent-500 flex-shrink-0 !shrink-0"
              :class="{ '-rotate-[45deg]': activeAccordion==id }"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v12m6-6H6"></path></svg
            >
          </button>
          <div
            x-show="activeAccordion==id"
            x-collapse=""
            style="display: none;"
          >
            <div class="p-4 pt-2 text-zinc-500">
              Currently, TabTab supports tab management for the following apps:
              {supportedAppGroups.map((group) => (
                <Fragment>
                  <h4 class="font-semibold mt-2">{group.label}:</h4>
                  <ul class="list-disc list-inside ml-4">
                    {group.names.map((name) => <li>{name}</li>)}
                  </ul>
                </Fragment>
              ))}
            </div>
          </div>
        </div>
        <div
          x-data="{ id: $id('accordion') }"
          :class="{ 'text-black': activeAccordion==id, 'text-zinc-600 hover:text-accent-500': activeAccordion!=id }"
          class="cursor-pointer group text-zinc-600 hover:text-accent-500"
        >
          <button
            @click="setActiveAccordion(id)"
            class="flex items-center justify-between w-full p-4 pb-1 text-left font-medium select-none"
          >
            <span
              >Experiencing issues with the tab tracking?</span
            >
            <svg
              style="min-width: 20px; min-height: 20px; width: 20px; height: 20px;"
              class="duration-300 ease-out text-accent-500 flex-shrink-0 !shrink-0"
              :class="{ '-rotate-[45deg]': activeAccordion==id }"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v12m6-6H6"></path></svg
            >
          </button>
          <div
            x-show="activeAccordion==id"
            x-collapse=""
            style="display: none;"
          >
            <div class="p-4 pt-2 text-zinc-500">
              Sorry to hear that! Please email <strong><em><span class="protected-email">hello@tabtabapp.net</span></em></strong> with:
              <ul class="list-disc list-inside mt-2">
                <li>The app name and version</li>
                <li>The macOS version</li>
                <li>Your Mac's system language</li>
              </ul>
            </div>
          </div>
        </div>
        <div
          x-data="{ id: $id('accordion') }"
          :class="{ 'text-black': activeAccordion==id, 'text-zinc-600 hover:text-accent-500': activeAccordion!=id }"
          class="cursor-pointer group text-zinc-600 hover:text-accent-500"
        >
          <button
            @click="setActiveAccordion(id)"
            class="flex items-center justify-between w-full p-4 pb-1 text-left font-medium select-none"
          >
            <span>Is a Windows version available?</span>
            <svg
              style="min-width: 20px; min-height: 20px; width: 20px; height: 20px;"
              class="duration-300 ease-out text-accent-500 flex-shrink-0 !shrink-0"
              :class="{ '-rotate-[45deg]': activeAccordion==id }"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6v12m6-6H6"></path></svg>
          </button>
          <div x-show="activeAccordion==id" x-collapse="" style="display: none;">
            <div class="p-4 pt-2 text-zinc-500">
              Windows support is not on the roadmap.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Email protection against spam bots
  function createEmailLink() {
    const user = 'riccqi';
    const domain = 'pm.me';
    const email = user + '@' + domain;
    return 'mailto:' + email;
  }

  // Make email clickable with protection
  document.addEventListener('DOMContentLoaded', function() {
    const emailElements = document.querySelectorAll('.protected-email');
    emailElements.forEach(element => {
      element.addEventListener('click', function(e) {
        e.preventDefault();
        window.location.href = createEmailLink();
      });
      (element as HTMLElement).style.cursor = 'pointer';
    });
  });
</script>
