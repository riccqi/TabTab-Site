---
// One accordion entry, matching the look of the entries in Faq.astro, with the
// button and panel linked for assistive technology.
interface Props {
  question: string;
}

const { question } = Astro.props;
---
<div
  x-data="{ id: $id('accordion') }"
  :class="{ 'text-black': activeAccordion==id, 'text-zinc-600 hover:text-accent-500': activeAccordion!=id }"
  class="cursor-pointer group text-zinc-600 hover:text-accent-500"
>
  <button
    type="button"
    @click="setActiveAccordion(id)"
    :id="id + '-button'"
    :aria-controls="id + '-panel'"
    :aria-expanded="(activeAccordion == id).toString()"
    aria-expanded="false"
    class="flex items-center justify-between w-full p-4 pb-1 text-left font-medium select-none"
  >
    <span>{question}</span>
    <svg
      aria-hidden="true"
      style="min-width: 20px; min-height: 20px; width: 20px; height: 20px;"
      class="duration-300 ease-out text-accent-500 flex-shrink-0 !shrink-0"
      :class="{ '-rotate-[45deg]': activeAccordion==id }"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 6v12m6-6H6"></path></svg
    >
  </button>
  <div
    x-show="activeAccordion==id"
    x-collapse=""
    :id="id + '-panel'"
    role="region"
    :aria-labelledby="id + '-button'"
  >
    <div class="p-4 pt-2 text-zinc-500">
      <slot />
    </div>
  </div>
</div>
