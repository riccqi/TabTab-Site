          <!-- Sound Toggle Button -->
          <button
            id="sound-toggle"
            type="button"
            hidden
            class="absolute bottom-2 right-2 sm:bottom-4 sm:right-4 bg-black/80 hover:bg-black/90 text-white p-2 sm:p-3 rounded-full transition-all duration-200 backdrop-blur-sm"
            aria-label="Unmute demo"
            aria-pressed="false"
          >
