---
// Subscription pricing (see src/data/billing.mjs).
import CheckIcon from "../CheckIcon.astro";
import ReviewWall from "../global/ReviewWall.astro";
import { billing, subscriptionPlan, planDisplayAmount } from "../../data/billing.mjs";

const { trialDays, devices } = subscriptionPlan;
---
<section aria-labelledby="pricing-section" id="pricing">
  <div class="lg:px-16 max-w-7xl md:px-12 mx-auto px-8 py-16 scroll-mt-20 lg:grid lg:grid-cols-2 lg:gap-16">
    <!-- Reviews sit beside the pricing on wide screens; the page shows a carousel below it otherwise. -->
    <div class="relative hidden lg:block">
      <div class="absolute inset-0">
        <ReviewWall />
      </div>
    </div>

    <div class="flex justify-center lg:block">
      <section
        aria-label="TabTab subscription"
        class="flex flex-col w-full max-w-md lg:max-w-lg p-6 md:p-10 rounded-panel border border-gray-200 bg-white"
      >
        <div class="self-start bg-gradient-to-br from-sky-200 to-sky-400 rounded-2xl p-4">
          <img src="/symbols/seal.fill.svg" alt="" class="w-8 h-8 filter brightness-0 invert">
        </div>

        <h1 id="pricing-section" class="mt-6 text-4xl tracking-tight font-medium text-black md:text-5xl font-display">
          Try {trialDays} days free
        </h1>
        <p class="mt-3 text-xl text-gray-700">
          Find and switch to any window or tab on your Mac.
        </p>

        <p class="mt-8 text-3xl font-semibold tracking-tight text-black font-display">{planDisplayAmount}</p>
        <p class="mt-2 text-sm leading-6 text-gray-500">
          {subscriptionPlan.currency} per {subscriptionPlan.interval} after trial
        </p>

        {billing.checkoutUrl ? (
          <a
            class="inline-flex items-center justify-center w-full px-6 py-3 h-12 mt-6 text-center font-medium text-white transition duration-200 ease-in-out bg-black border border-black rounded-button hover:bg-accent-600 hover:border-accent-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
            href={billing.checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
          >Start free trial</a>
        ) : (
          <p
            class="inline-flex items-center justify-center w-full px-6 py-3 min-h-12 mt-6 text-center font-medium text-gray-500 border border-gray-200 bg-gray-50 rounded-button"
            role="status"
          >Subscriptions are coming soon</p>
        )}

        <hr class="mt-8 border-gray-200">

        <p class="mt-8 font-display font-semibold text-black">Everything included:</p>
        <ul role="list" class="flex flex-col mt-4 text-gray-600 gap-y-3">
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Switch to any window or tab</span></li>
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Search by title, URL or app name</span></li>
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Up to {devices} Macs per subscription</span></li>
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Cancel anytime</span></li>
        </ul>
      </section>
    </div>
  </div>
</section>
