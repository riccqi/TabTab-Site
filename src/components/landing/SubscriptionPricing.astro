---
// Monthly, Annual and Lifetime plans (see src/data/billing.mjs).
import CheckIcon from "../CheckIcon.astro";
import ReviewWall from "../global/ReviewWall.astro";
import { annualSavingPercent, billing, defaultPlanId, macsPerPlan, plans, trialDays } from "../../data/billing.mjs";

const buttonBase = "inline-flex items-center justify-center w-full h-12 px-4 text-center font-medium transition duration-200 ease-in-out rounded-button focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black";
---
<section aria-labelledby="pricing-section" id="pricing">
  <div class="lg:px-16 max-w-7xl md:px-12 mx-auto px-8 py-16 scroll-mt-20 lg:grid lg:grid-cols-2 lg:gap-16">
    <!-- Reviews sit beside the pricing on wide screens; the page shows a carousel below it otherwise. -->
    <div class="relative hidden lg:block">
      <div class="absolute inset-0">
        <ReviewWall />
      </div>
    </div>

    <div class="flex justify-center lg:block">
      <section
        aria-label="TabTab plans"
        x-data={`{ plan: '${defaultPlanId}' }`}
        class="flex flex-col w-full max-w-md lg:max-w-lg p-6 md:p-10 rounded-panel border border-gray-200 bg-white"
      >
        <div class="self-start bg-gradient-to-br from-sky-200 to-sky-400 rounded-2xl p-4">
          <img src="/symbols/seal.fill.svg" alt="" class="w-8 h-8 filter brightness-0 invert">
        </div>

        <h1 id="pricing-section" class="mt-6 text-4xl tracking-tight font-medium text-black md:text-5xl font-display">
          Choose your plan
        </h1>

        <fieldset class="mt-8">
          <legend class="sr-only">Billing option</legend>
          <div class="grid grid-cols-3 gap-1 rounded-button bg-gray-100 p-1">
            {plans.map(plan => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="plan"
                  value={plan.id}
                  x-model="plan"
                  checked={plan.id === defaultPlanId}
                  class="peer sr-only"
                >
                <span class="flex h-10 items-center justify-center rounded-button text-sm font-medium text-gray-600 duration-200 hover:text-black peer-checked:bg-black peer-checked:text-white peer-checked:hover:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-black">
                  {plan.label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-6">
          {plans.map(plan => (
            <div x-show={`plan === '${plan.id}'`} style={plan.id === defaultPlanId ? undefined : "display: none"}>
              <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-display">
                <span class="text-3xl font-semibold tracking-tight text-black">${plan.price}</span>
                <span class="text-lg text-gray-600">{plan.unit}</span>
                {plan.id === "annual" && (
                  <span class="self-center rounded-full bg-sky-100 px-2.5 py-0.5 text-sm font-medium text-sky-800">Saves about {annualSavingPercent}% vs monthly</span>
                )}
              </p>
              <p class="mt-2 text-sm leading-6 text-gray-500">{plan.detail}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <div>
            {plans.map(plan => billing.checkout[plan.id] ? (
              <a
                class:list={[buttonBase, "text-white bg-black border border-black hover:bg-accent-600 hover:border-accent-600"]}
                href={billing.checkout[plan.id]}
                target="_blank"
                rel="noopener noreferrer"
                x-show={`plan === '${plan.id}'`}
                style={plan.id === defaultPlanId ? undefined : "display: none"}
              >Buy Now</a>
            ) : (
              <p
                class={`${buttonBase} text-sm text-gray-500 border border-gray-200 bg-gray-50`}
                role="status"
                x-show={`plan === '${plan.id}'`}
                style={plan.id === defaultPlanId ? undefined : "display: none"}
              >Checkout coming soon</p>
            ))}
          </div>
          <a
            class:list={[buttonBase, "text-black bg-white border border-black hover:bg-gray-100"]}
            href="/download/"
          >Try for Free</a>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          Trying first is optional: {trialDays} days free, no account or card.
        </p>

        <hr class="mt-8 border-gray-200">

        <p class="mt-8 font-display font-semibold text-black">Every plan includes:</p>
        <ul role="list" class="flex flex-col mt-4 text-gray-600 gap-y-3">
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Switch to any window or tab</span></li>
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Search by title, URL or app name</span></li>
          <li class="flex items-center"><CheckIcon /><span class="ml-3">Use on up to {macsPerPlan} Macs</span></li>
        </ul>
      </section>
    </div>
  </div>
</section>
