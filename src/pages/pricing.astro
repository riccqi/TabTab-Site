---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignup from "../components/landing/EmailSignup.astro";
import PricingFaq from "../components/infopages/PricingFaq.astro";
import Testimonial from "../components/global/Testimonial.astro";
import SubscriptionPricing from "../components/landing/SubscriptionPricing.astro";
import { macsPerPlan, planPriceSummary, trialDays } from "../data/billing.mjs";

const title = "TabTab Pricing | Monthly, Annual and Lifetime Plans";
const description = `TabTab is ${planPriceSummary}, for up to ${macsPerPlan} Macs. Try it free for ${trialDays} days first, with no account or card.`;
---
<BaseLayout
  title={title}
  description={description}
>
  <div>
    <SubscriptionPricing />
    <div class="lg:hidden">
      <Testimonial />
    </div>
    <EmailSignup />
    <PricingFaq />
  </div>
</BaseLayout>
