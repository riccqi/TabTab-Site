---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignup from "../components/landing/EmailSignup.astro";
import Faq from "../components/infopages/Faq.astro";
import Testimonial from "../components/global/Testimonial.astro";
import SubscriptionPricing from "../components/landing/SubscriptionPricing.astro";
import { subscriptionPlan, planPrice } from "../data/billing.mjs";

const title = `TabTab Pricing | ${subscriptionPlan.trialDays}-Day Free Trial, then ${planPrice}`;
const description = `TabTab is ${planPrice} after a ${subscriptionPlan.trialDays}-day free trial, for up to ${subscriptionPlan.devices} Macs. Cancel anytime.`;
---
<BaseLayout
  title={title}
  description={description}
>
  <div>
    <SubscriptionPricing />
    <div class="lg:hidden">
      <Testimonial />
    </div>
    <EmailSignup />
    <Faq />
  </div>
</BaseLayout>
