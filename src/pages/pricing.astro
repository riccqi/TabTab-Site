---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignup from "../components/landing/EmailSignup.astro";
import Faq from "../components/infopages/Faq.astro";
import SubscriptionPricing from "../components/landing/SubscriptionPricing.astro";
import { subscriptionPlan, planPrice } from "../data/billing.mjs";

const title = `TabTab Pricing | ${subscriptionPlan.trialDays}-Day Free Trial, then ${planPrice}`;
const description = `TabTab is ${planPrice} after a ${subscriptionPlan.trialDays}-day free trial, for ${subscriptionPlan.devices} Mac. Cancel anytime.`;
---
<BaseLayout
  title={title}
  description={description}
>
  <div>
    <SubscriptionPricing />
    <EmailSignup />
    <Faq />
  </div>
</BaseLayout>
