---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | null;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, socialImage, ogType, structuredData } = Astro.props;
---
<html
  lang="en"
  class="scroll-smooth selection:bg-accent-500 selection:text-white no-touchevents hydrated"
>
  <head>
    <BaseHead
      title={title}
      description={description}
      socialImage={socialImage}
      ogType={ogType}
      structuredData={structuredData}
    />
  </head>
  <body class="bg-white flex flex-col min-h-svh">
    <Navigation/>
    <main class="grow"><slot /></main>
    <Footer/>
  </body>
</html>
